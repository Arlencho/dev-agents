.env
.env.*
!.env.example
.DS_Store
node_modules/

# Agent logs (collected from workers)
logs/*.log
!logs/.gitkeep

# Local Sentinel runtime state (not source of truth)
logs/local-sentinel-status.json

# Wave plan execution logs contain timestamps, keep .plan files
wave-plans/*.log
!wave-plans/.gitkeep

# Learnings data (generated at runtime, contains project-specific JSONL)
learnings/*.jsonl
!learnings/.gitkeep

# Rate-cap sentinel runtime state (per-machine)
logs/provider-state/

# Evidence scorecard outputs (aggregates; no secrets expected)
logs/evidence.csv
logs/evidence-latest.txt

# Fleet Desk Phase 0 generated static site
site/experience/
